{
  "name": "Notifica\u00e7\u00e3o Push Cliente",
  "description": "Notifica o cliente no celular no aceite, inclusive em fila, e nas etapas ou ajustes do chamado.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "ServiceRequest",
      "events": [
        "update"
      ]
    },
    "condition": "${ ((.trigger.changed_fields // []) | index(\"accepted_at\") != null or index(\"status\") != null or index(\"locksmith_arrived\") != null or index(\"end_photos\") != null or index(\"description\") != null) }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "push_cliente_andamento",
      "version": "1.2",
      "namespace": "base44"
    },
    "do": [
      {
        "notificar_cliente": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendClientPushNotification",
            "args": {
              "service_request_id": "${ .trigger.entity_id }",
              "notification_key": "${ if (((.trigger.changed_fields // []) | index(\"accepted_at\")) != null or .trigger.data.status == \"accepted\" or .trigger.data.status == \"queued\") then \"accepted\" else null end }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Notificar cliente",
            "description": "Aceite, etapa ou ajuste do chamado"
          }
        }
      }
    ]
  }
}