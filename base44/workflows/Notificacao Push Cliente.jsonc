{
  "name": "Notifica\u00e7\u00e3o Push Cliente",
  "description": "Envia notifica\u00e7\u00e3o push ao cliente nas etapas do chamado e quando houver ajuste comprovado de condi\u00e7\u00e3o e valor",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "ServiceRequest",
      "events": [
        "update"
      ]
    },
    "condition": "${ ((.trigger.changed_fields // []) | index(\"status\") != null or index(\"locksmith_arrived\") != null or index(\"end_photos\") != null or index(\"description\") != null) }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "push_cliente_andamento",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notificar_cliente": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendClientPushNotification",
            "args": {
              "service_request_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Notificar cliente",
            "description": "Etapa ou ajuste do chamado"
          }
        }
      }
    ]
  }
}