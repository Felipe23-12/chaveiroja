{
  "name": "Notifica\u00e7\u00e3o Push Mensagem Chat",
  "description": "Envia notifica\u00e7\u00e3o push ao destinat\u00e1rio sempre que uma nova mensagem de chat \u00e9 enviada, para que o alerta toque e apare\u00e7a na tela do celular mesmo com o app fechado",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "ChatMessage",
      "events": [
        "create"
      ]
    },
    "condition": null
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "push_mensagem_chat",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_push": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendChatPushNotification",
            "args": {
              "chat_message_id": "${ .trigger.entity_id }",
              "_internal_token": "${ .secrets.INTERNAL_CALL_TOKEN }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Notificar destinat\u00e1rio",
            "description": "Push da nova mensagem"
          }
        }
      }
    ]
  }
}