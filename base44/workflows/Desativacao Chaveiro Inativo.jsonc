{
  "name": "Desativa\u00e7\u00e3o Chaveiro Inativo",
  "description": "Todos os dias verifica perfis offline h\u00e1 30 dias sem acesso ao aplicativo. Acessos ou presen\u00e7a online reiniciam a contagem, sem exigir aceites de chamados.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 4 * * *",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "desativacao_chaveiro_inativo",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "verificar_inatividade": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "deactivateInactiveLocksmiths",
            "args": {
              "_internal_token": "${ .secrets.INTERNAL_CALL_TOKEN }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Verificar chaveiros inativos",
            "description": "30 dias offline e sem acesso ao app"
          }
        }
      }
    ]
  }
}