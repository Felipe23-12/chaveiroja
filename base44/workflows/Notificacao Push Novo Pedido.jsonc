{
  "name": "Notifica\u00e7\u00e3o Push Novo Pedido",
  "description": "Envia uma notifica\u00e7\u00e3o push ao chaveiro mais pr\u00f3ximo assim que um cliente finaliza um pedido, informando o tipo de servi\u00e7o e a localiza\u00e7\u00e3o exata",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "ServiceRequest",
      "events": [
        "create"
      ]
    },
    "condition": "${ .trigger.data.locksmith_id != null and (.trigger.data.status == \"searching\" or .trigger.data.status == \"ringing\") }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "push_novo_pedido",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_push": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendLocksmithPushNotification",
            "args": {
              "service_request_id": "${ .trigger.entity_id }",
              "_internal_token": "cj_wf_int_7d2e5a1f9b8c4e30"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Notificar chaveiro",
            "description": "Push com tipo de servi\u00e7o e localiza\u00e7\u00e3o"
          }
        }
      }
    ]
  }
}