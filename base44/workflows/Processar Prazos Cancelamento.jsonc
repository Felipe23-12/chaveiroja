{
  "name": "Processar Prazos de Cancelamento",
  "description": "Processa esperas, suspens\u00f5es e abandonos dos fluxos de cancelamento.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "processar_prazos_cancelamento",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "processar": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processCancellationDeadlines",
            "args": {
              "_internal_token": "${ .secrets.INTERNAL_CALL_TOKEN }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Processar cancelamentos",
            "description": "Aplica prazos e libera suspens\u00f5es"
          }
        }
      }
    ]
  }
}