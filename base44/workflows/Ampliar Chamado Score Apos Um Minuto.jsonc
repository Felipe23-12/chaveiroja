{
  "name": "Ampliar Chamado Score Apos Um Minuto",
  "description": "Após 60 segundos sem aceite, inclui scores menores mantendo os chaveiros score 10.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "ServiceRequest",
      "events": [
        "create"
      ]
    },
    "condition": "${ .trigger.data.status == \"ringing\" and (.trigger.data.apple_review != true) and (.trigger.data.score_priority_until != null) }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "ampliar_chamado_score",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "aguardar_prioridade": {
          "wait": "PT1M",
          "then": "ampliar_score",
          "x-base44": {
            "title": "Aguardar 1 minuto"
          }
        }
      },
      {
        "ampliar_score": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "expandScoreDispatch",
            "args": {
              "_internal_token": "${ .secrets.INTERNAL_CALL_TOKEN }",
              "request_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Incluir scores menores"
          }
        }
      }
    ]
  }
}
