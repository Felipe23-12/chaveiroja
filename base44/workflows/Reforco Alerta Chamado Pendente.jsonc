            "description": "Chamados ainda tocando"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 5,
      "interval_unit": "minutes",
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "A cada 5 minutos, reenvia a notifica\u00e7\u00e3o push aos chaveiros com chamados ainda tocando, garantindo o alerta com o app em segundo plano",
  "name": "Refor\u00e7o Alerta Chamado Pendente"
