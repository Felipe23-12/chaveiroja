{
  "description": "Refor\u00e7a os alertas de chamados pendentes em cinco rodadas separadas por um minuto; recusas respeitam a espera de 60 segundos.",
  "name": "Refor\u00e7o Alerta Chamado Pendente",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "reforco_alerta_chamado",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "repeat_push": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "repeatRingingPushAlerts",
            "args": {
              "_internal_token": "${ .secrets.INTERNAL_CALL_TOKEN }"
            }
          },
          "then": "wait_one",
          "x-base44": {
            "title": "Reenviar alerta",
            "description": "Chamados tocando ou em busca"
          }
        }
      },
      {
        "wait_one": {
          "wait": "PT1M",
          "then": "repeat_two",
          "x-base44": {
            "title": "Aguardar um minuto"
          }
        }
      },
      {
        "repeat_two": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "repeatRingingPushAlerts",
            "args": {
              "_internal_token": "${ .secrets.INTERNAL_CALL_TOKEN }"
            }
          },
          "then": "wait_two",
          "x-base44": {
            "title": "Refor\u00e7ar chamados pendentes"
          }
        }
      },
      {
        "wait_two": {
          "wait": "PT1M",
          "then": "repeat_three",
          "x-base44": {
            "title": "Aguardar um minuto"
          }
        }
      },
      {
        "repeat_three": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "repeatRingingPushAlerts",
            "args": {
              "_internal_token": "${ .secrets.INTERNAL_CALL_TOKEN }"
            }
          },
          "then": "wait_three",
          "x-base44": {
            "title": "Refor\u00e7ar chamados pendentes"
          }
        }
      },
      {
        "wait_three": {
          "wait": "PT1M",
          "then": "repeat_four",
          "x-base44": {
            "title": "Aguardar um minuto"
          }
        }
      },
      {
        "repeat_four": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "repeatRingingPushAlerts",
            "args": {
              "_internal_token": "${ .secrets.INTERNAL_CALL_TOKEN }"
            }
          },
          "then": "wait_four",
          "x-base44": {
            "title": "Refor\u00e7ar chamados pendentes"
          }
        }
      },
      {
        "wait_four": {
          "wait": "PT1M",
          "then": "repeat_five",
          "x-base44": {
            "title": "Aguardar um minuto"
          }
        }
      },
      {
        "repeat_five": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "repeatRingingPushAlerts",
            "args": {
              "_internal_token": "${ .secrets.INTERNAL_CALL_TOKEN }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Refor\u00e7ar chamados pendentes"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}