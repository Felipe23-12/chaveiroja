{
  "name": "Refor\u00e7o Alerta Chamado Pendente",
  "description": "A cada 5 minutos, reenvia a notifica\u00e7\u00e3o push aos chaveiros com chamados ainda tocando ou em busca",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "reforco_alerta_chamado",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "repeat_push": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "repeatRingingPushAlerts",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Reenviar alerta",
            "description": "Chamados tocando ou em busca"
          }
        }
      }
    ]
  }
}