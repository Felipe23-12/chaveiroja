{
  "name": "Notifica\u00e7\u00e3o Chaveiro A\u00e7\u00f5es do Cliente",
  "description": "Avisa o chaveiro quando o cliente cancela, confirma sua chegada ou seleciona pagamento em dinheiro.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "ServiceRequest",
      "events": [
        "update"
      ]
    },
    "condition": "${ (.trigger.data.status == \"cancelled\" and .trigger.data.cancelled_by == \"cliente\" and (.trigger.old_data.status != \"cancelled\" or .trigger.old_data.cancelled_by != \"cliente\")) or (.trigger.data.client_arrived_confirmed == true and .trigger.old_data.client_arrived_confirmed != true and .trigger.data.locksmith_arrived == true and (.trigger.data.status == \"accepted\" or .trigger.data.status == \"on_the_way\")) or (.trigger.data.payment_method == \"dinheiro\" and .trigger.old_data.payment_method != \"dinheiro\" and .trigger.data.client_confirmed == true and (.trigger.data.status == \"accepted\" or .trigger.data.status == \"on_the_way\")) }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notificacao_chaveiro_acoes_cliente",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "notificar_chaveiro": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendLocksmithPushNotification",
            "args": {
              "service_request_id": "${ .trigger.entity_id }",
              "event_type": "${ if .trigger.data.status == \"cancelled\" then \"client_cancelled\" elif .trigger.data.payment_method == \"dinheiro\" and .trigger.old_data.payment_method != \"dinheiro\" then \"cash_payment_selected\" else \"arrival_confirmed\" end }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Avisar chaveiro",
            "description": "A\u00e7\u00e3o importante do cliente"
          }
        }
      }
    ]
  }
}