{
  "name": "Lembrete de Aprova\u00e7\u00e3o Stripe para Chaveiros",
  "description": "A cada 5 dias envia um e-mail aos chaveiros cuja conta Stripe ainda n\u00e3o est\u00e1 aprovada para pagamentos e repasses.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 5,
      "interval_unit": "days",
      "interval_anchor": "2026-09-07T13:00:00Z",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "lembrete_aprovacao_stripe_chaveiros",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "enviar_lembretes": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendStripeApprovalReminders",
            "args": {
              "_internal_token": "${ .secrets.INTERNAL_CALL_TOKEN }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Enviar lembretes do Stripe",
            "description": "Somente para contas ainda n\u00e3o aprovadas"
          }
        }
      }
    ]
  }
}