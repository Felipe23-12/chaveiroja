{
  "name": "Atualização FIPE do catálogo",
  "description": "Até 10 consultas a cada 2h distribuídas entre Parallelum (6), arquivo mensal fipeX (1) e TabelaFIPE.info (até 3), com cursores independentes.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 */2 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "atualizacao_fipe_catalogo",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sincronizar_fipe": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncFipeCatalog",
            "args": {
              "_internal_token": "${ .secrets.INTERNAL_CALL_TOKEN }"
            }
          },
          "x-base44": {
            "title": "Atualizar preços FIPE",
            "description": "Avançar lote de até 10 consultas a cada 2 horas e conferir revisões vencidas"
          }
        }
      },
      {
        "fontes_alternativas": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncFipeAlternatives",
            "args": {
              "_internal_token": "${ .secrets.INTERNAL_CALL_TOKEN }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Complementar FIPE por fontes alternativas",
            "description": "Importar arquivo mensal e preços por família sem disputar o cursor Parallelum"
          }
        }
      }
    ]
  }
}
