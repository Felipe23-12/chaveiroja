{
  "name": "Notifica\u00e7\u00e3o Push Chamado Ampliado",
  "description": "Quando o raio de busca \u00e9 ampliado e o chamado passa a tocar para novos chaveiros, envia push nativo (com som no celular) apenas para quem ainda n\u00e3o foi avisado",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "ServiceRequest",
      "events": [
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"ringing\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "push_chamado_ampliado",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_push": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendLocksmithPushNotification",
            "args": {
              "service_request_id": "${ .trigger.entity_id }",
              "_internal_token": "cj_wf_int_7d2e5a1f9b8c4e30"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Notificar novos chaveiros",
            "description": "Push apenas para os chaveiros que entraram no chamado"
          }
        }
      }
    ]
  }
}