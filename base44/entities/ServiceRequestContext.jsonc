{
  "name": "ServiceRequestContext",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "service_type": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "place_type": {
      "type": "string",
      "enum": [
        "individual",
        "condominium",
        "unknown",
        "vehicle"
      ]
    },
    "building": {
      "type": "string"
    },
    "unit": {
      "type": "string"
    },
    "vehicle_plate": {
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "client_id",
    "service_type",
    "address",
    "place_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}