{
  "name": "Payment",
  "type": "object",
  "properties": {
    "service_request_id": {
      "type": "string",
      "description": "ID do atendimento ou refer\u00eancia da mensalidade"
    },
    "locksmith_id": {
      "type": "string"
    },
    "locksmith_user_id": {
      "type": "string",
      "description": "Propriet\u00e1rio do perfil de chaveiro, preenchido pelo servidor"
    },
    "locksmith_name": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0,
      "description": "Valor total pago"
    },
    "commission_amount": {
      "type": "number",
      "default": 0,
      "description": "Comiss\u00e3o do app e compensa\u00e7\u00f5es de comiss\u00f5es em dinheiro"
    },
    "net_amount": {
      "type": "number",
      "default": 0,
      "description": "Parcela bruta do chaveiro antes da tarifa do Mercado Pago"
    },
    "method": {
      "type": "string",
      "enum": [
        "credit_card",
        "debit_card",
        "pix"
      ],
      "description": "M\u00e9todo efetivamente usado no Mercado Pago"
    },
    "status": {
      "type": "string",
      "enum": [
        "pre_authorized",
        "captured",
        "paid",
        "cancelled",
        "refunded",
        "failed"
      ],
      "default": "pre_authorized"
    },
    "provider": {
      "type": "string",
      "enum": [
        "mercado_pago",
        "stripe"
      ],
      "default": "mercado_pago"
    },
    "payment_kind": {
      "type": "string",
      "enum": [
        "service",
        "cancellation",
        "subscription"
      ],
      "default": "service"
    },
    "collection_mode": {
      "type": "string",
      "enum": [
        "seller_split",
        "platform_pending",
        "platform_subscription"
      ],
      "description": "Destino definido na cria\u00e7\u00e3o da cobran\u00e7a, n\u00e3o muda quando o chaveiro conecta sua conta"
    },
    "collector_id": {
      "type": "string",
      "description": "ID Mercado Pago da conta recebedora validado no servidor"
    },
    "transfer_status": {
      "type": "string",
      "enum": [
        "awaiting_payment",
        "pending",
        "under_review",
        "reversed",
        "transferred"
      ],
      "description": "Cr\u00e9ditos retidos na plataforma; apenas \"transferred\" representa repasse manual j\u00e1 realizado ao chaveiro"
    },
    "transferred_at": {
      "type": "string",
      "format": "date-time",
      "description": "Quando um admin confirmou o repasse manual deste cr\u00e9dito pendente ao chaveiro"
    },
    "pending_transfer_amount": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Cr\u00e9dito l\u00edquido pendente, ap\u00f3s comiss\u00e3o, compensa\u00e7\u00f5es e tarifa do Mercado Pago confirmada"
    },
    "provider_fee_amount": {
      "type": "number",
      "minimum": 0,
      "description": "Tarifa confirmada pelo Mercado Pago para o recebimento na plataforma"
    },
    "provider_updated_at": {
      "type": "string",
      "description": "Vers\u00e3o de atualiza\u00e7\u00e3o do pagamento no Mercado Pago"
    },
    "mercado_pago_preference_id": {
      "type": "string"
    },
    "mercado_pago_payment_id": {
      "type": "string"
    },
    "stripe_payment_intent_id": {
      "type": "string",
      "description": "Refer\u00eancia legada de pagamentos Stripe"
    },
    "pre_authorized_at": {
      "type": "string",
      "format": "date-time"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "service_request_id",
    "amount",
    "method"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "data.locksmith_id": "{{user.id}}"
        },
        {
          "data.locksmith_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.collection_mode": {
                "$ne": "platform_pending"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.collection_mode": {
                "$ne": "platform_pending"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}