{
  "name": "Payment",
  "type": "object",
  "properties": {
    "service_request_id": {
      "type": "string",
      "description": "ID do atendimento ou refer\u00eancia da mensalidade"
    },
    "locksmith_id": {
      "type": "string"
    },
    "locksmith_user_id": {
      "type": "string",
      "description": "Propriet\u00e1rio do perfil de chaveiro, preenchido pelo servidor"
    },
    "locksmith_name": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "commission_amount": {
      "type": "number",
      "default": 0
    },
    "net_amount": {
      "type": "number",
      "default": 0
    },
    "cash_offset_amount": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Parcela da d\u00edvida anterior de comiss\u00e3o em dinheiro reservada neste pagamento"
    },
    "cash_offset_settled": {
      "type": "boolean",
      "default": false,
      "description": "Confirma que a parcela reservada j\u00e1 foi baixada do saldo devedor"
    },
    "cash_offset_settlement_token": {
      "type": "string",
      "description": "Trava idempotente interna do processamento da baixa"
    },
    "cash_offset_settled_at": {
      "type": "string",
      "format": "date-time"
    },
    "method": {
      "type": "string",
      "enum": [
        "credit_card",
        "debit_card",
        "pix"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pre_authorized",
        "captured",
        "paid",
        "cancelled",
        "refunded",
        "failed"
      ],
      "default": "pre_authorized"
    },
    "provider": {
      "type": "string",
      "enum": [
        "mercado_pago",
        "stripe"
      ],
      "default": "mercado_pago"
    },
    "payment_kind": {
      "type": "string",
      "enum": [
        "service",
        "cancellation",
        "subscription"
      ],
      "default": "service"
    },
    "collection_mode": {
      "type": "string",
      "enum": [
        "seller_split",
        "platform_pending",
        "platform_subscription"
      ]
    },
    "collector_id": {
      "type": "string"
    },
    "transfer_status": {
      "type": "string",
      "enum": [
        "awaiting_payment",
        "pending",
        "under_review",
        "reversed",
        "transferred"
      ]
    },
    "transferred_at": {
      "type": "string",
      "format": "date-time"
    },
    "pending_transfer_amount": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "provider_fee_amount": {
      "type": "number",
      "minimum": 0
    },
    "provider_updated_at": {
      "type": "string"
    },
    "mercado_pago_preference_id": {
      "type": "string"
    },
    "mercado_pago_payment_id": {
      "type": "string"
    },
    "stripe_payment_intent_id": {
      "type": "string"
    },
    "pre_authorized_at": {
      "type": "string",
      "format": "date-time"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "service_request_id",
    "amount",
    "method"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "data.locksmith_id": "{{user.id}}"
        },
        {
          "data.locksmith_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}