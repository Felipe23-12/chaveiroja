{
  "name": "Payment",
  "type": "object",
  "properties": {
    "service_request_id": {
      "type": "string",
      "description": "ID do atendimento ou refer\u00eancia da mensalidade"
    },
    "locksmith_id": {
      "type": "string"
    },
    "locksmith_name": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0,
      "description": "Valor total pago"
    },
    "commission_amount": {
      "type": "number",
      "default": 0,
      "description": "Comiss\u00e3o do app (15% nos atendimentos)"
    },
    "net_amount": {
      "type": "number",
      "default": 0,
      "description": "Parcela bruta do chaveiro antes da tarifa do Mercado Pago"
    },
    "method": {
      "type": "string",
      "enum": [
        "credit_card",
        "debit_card",
        "pix"
      ],
      "description": "M\u00e9todo efetivamente usado no Mercado Pago"
    },
    "status": {
      "type": "string",
      "enum": [
        "pre_authorized",
        "captured",
        "paid",
        "cancelled",
        "refunded",
        "failed"
      ],
      "default": "pre_authorized"
    },
    "provider": {
      "type": "string",
      "enum": [
        "mercado_pago",
        "stripe"
      ],
      "default": "mercado_pago"
    },
    "payment_kind": {
      "type": "string",
      "enum": [
        "service",
        "cancellation",
        "subscription"
      ],
      "default": "service"
    },
    "mercado_pago_preference_id": {
      "type": "string"
    },
    "mercado_pago_payment_id": {
      "type": "string"
    },
    "stripe_payment_intent_id": {
      "type": "string",
      "description": "Refer\u00eancia legada de pagamentos Stripe"
    },
    "pre_authorized_at": {
      "type": "string",
      "format": "date-time"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "service_request_id",
    "amount",
    "method"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}