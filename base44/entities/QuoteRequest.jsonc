{
  "name": "QuoteRequest",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "locksmith_id": {
      "type": "string"
    },
    "locksmith_user_id": {
      "type": "string"
    },
    "locksmith_name": {
      "type": "string"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "Confec\u00e7\u00e3o de Chave de Carro",
        "Reparo de Fechadura Automotiva"
      ]
    },
    "repair_part": {
      "type": "string",
      "enum": [
        "ignicao",
        "porta_malas",
        "porta",
        "chave_quebrada"
      ]
    },
    "vehicle_info": {
      "type": "string",
      "maxLength": 160
    },
    "address": {
      "type": "string",
      "maxLength": 300
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "customer_lat": {
      "type": "number"
    },
    "customer_lng": {
      "type": "number"
    },
    "day_key": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "inspecting",
        "offered",
        "countered",
        "accepted",
        "declined"
      ]
    },
    "offered_price": {
      "type": "number",
      "minimum": 0
    },
    "counter_price": {
      "type": "number",
      "minimum": 0
    },
    "accepted_price": {
      "type": "number",
      "minimum": 0
    },
    "service_request_id": {
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "locksmith_id",
    "locksmith_user_id",
    "service_type",
    "vehicle_info",
    "address",
    "customer_lat",
    "customer_lng",
    "day_key",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "data.locksmith_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}