{
  "name": "ServiceRequest",
  "type": "object",
  "properties": {
    "service_type": {
      "type": "string",
      "enum": [
        "Abertura Residencial",
        "Abertura Automotiva",
        "Abertura Fechadura Tetra",
        "Abertura Fechadura Eletr\u00f4nica"
      ],
      "default": "Abertura Residencial"
    },
    "status": {
      "type": "string",
      "enum": [
        "searching",
        "ringing",
        "accepted",
        "on_the_way",
        "completed",
        "cancelled"
      ],
      "default": "searching"
    },
    "address": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "urgency": {
      "type": "string",
      "enum": [
        "normal",
        "urgent"
      ],
      "default": "normal"
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "locksmith_id": {
      "type": "string"
    },
    "locksmith_name": {
      "type": "string"
    },
    "rating": {
      "type": "number"
    },
    "review": {
      "type": "string"
    },
    "customer_lat": {
      "type": "number"
    },
    "customer_lng": {
      "type": "number"
    },
    "locksmith_lat": {
      "type": "number"
    },
    "locksmith_lng": {
      "type": "number"
    }
  },
  "required": [
    "service_type",
    "address"
  ]
}