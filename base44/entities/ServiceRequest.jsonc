{
  "name": "ServiceRequest",
  "type": "object",
  "properties": {
    "service_type": {
      "type": "string",
      "enum": [
        "Abertura Residencial",
        "Abertura Automotiva",
        "Abertura Fechadura Tetra",
        "Abertura Fechadura Eletr\u00f4nica",
        "Confec\u00e7\u00e3o de Chave de Carro",
        "Confec\u00e7\u00e3o de Chave de Moto",
        "C\u00f3pia de Chave"
      ],
      "default": "Abertura Residencial"
    },
    "status": {
      "type": "string",
      "enum": [
        "searching",
        "ringing",
        "queued",
        "accepted",
        "on_the_way",
        "completed",
        "cancelled"
      ],
      "default": "searching"
    },
    "address": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "urgency": {
      "type": "string",
      "enum": [
        "normal",
        "urgent"
      ],
      "default": "normal"
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "locksmith_id": {
      "type": "string"
    },
    "locksmith_name": {
      "type": "string"
    },
    "locksmith_user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio dono do perfil designado"
    },
    "ringing_locksmith_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "ringing_locksmith_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "push_notified_locksmith_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "rejections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "locksmith_id": {
            "type": "string"
          },
          "rering_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": []
    },
    "rating": {
      "type": "number"
    },
    "review": {
      "type": "string"
    },
    "review_claimed": {
      "type": "boolean",
      "default": false
    },
    "customer_lat": {
      "type": "number"
    },
    "customer_lng": {
      "type": "number"
    },
    "locksmith_lat": {
      "type": "number"
    },
    "locksmith_lng": {
      "type": "number"
    },
    "key_value": {
      "type": "number"
    },
    "fipe_value": {
      "type": "number"
    },
    "key_type": {
      "type": "string"
    },
    "vehicle_info": {
      "type": "string"
    },
    "labor_cost": {
      "type": "number"
    },
    "locomotion_cost": {
      "type": "number"
    },
    "distance_km": {
      "type": "number"
    },
    "extra_cost": {
      "type": "number",
      "default": 0
    },
    "replaced_parts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "commission_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid"
      ],
      "default": "pending"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "queued_at": {
      "type": "string",
      "format": "date-time"
    },
    "queued_after_request_id": {
      "type": "string"
    },
    "cancelled_by": {
      "type": "string",
      "enum": [
        "cliente",
        "chaveiro",
        "sistema"
      ]
    },
    "cancellation_fee": {
      "type": "number",
      "default": 0
    },
    "cancellation_locksmith_amount": {
      "type": "number",
      "default": 0
    },
    "cancellation_app_fee": {
      "type": "number",
      "default": 0
    },
    "cancellation_reason": {
      "type": "string"
    },
    "locksmith_arrived": {
      "type": "boolean",
      "default": false
    },
    "client_arrived_confirmed": {
      "type": "boolean",
      "default": false
    },
    "start_photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "end_photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "discount_applied": {
      "type": "boolean",
      "default": false
    },
    "discount_amount": {
      "type": "number",
      "default": 0
    },
    "payment_id": {
      "type": "string"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "credit_card",
        "debit_card",
        "pix",
        "dinheiro"
      ]
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "pre_authorized",
        "captured",
        "paid",
        "cancelled",
        "refunded"
      ],
      "default": "pending"
    },
    "client_confirmed": {
      "type": "boolean",
      "default": false
    },
    "locksmith_confirmed": {
      "type": "boolean",
      "default": false
    },
    "cash_received": {
      "type": "boolean",
      "default": false
    },
    "rering_at": {
      "type": "string",
      "format": "date-time"
    },
    "client_push_sent": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "urgency_upgrade_status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined"
      ]
    },
    "urgency_upgrade_requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "urgency_upgrade_price": {
      "type": "number"
    },
    "pricing_calculation": {
      "type": "object",
      "description": "Mem\u00f3ria do c\u00e1lculo utilizado na solicita\u00e7\u00e3o, antes do desconto; n\u00e3o recalculada com tarifas futuras.",
      "properties": {
        "total": {
          "type": "number"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "label",
              "value"
            ]
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "total",
        "lines"
      ]
    }
  },
  "required": [
    "service_type",
    "address"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.status": "ringing"
        },
        {
          "data.payment_status": "pending"
        },
        {
          "data.cash_received": false
        },
        {
          "data.client_confirmed": false
        },
        {
          "data.locksmith_confirmed": false
        },
        {
          "data.cancellation_fee": 0
        },
        {
          "data.review_claimed": false
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.locksmith_user_id": "{{user.id}}"
        },
        {
          "data.ringing_locksmith_user_ids": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}