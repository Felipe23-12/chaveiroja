{
  "name": "ServiceRequest",
  "type": "object",
  "properties": {
    "service_type": {
      "type": "string",
      "enum": [
        "Abertura Residencial",
        "Abertura Automotiva",
        "Abertura Fechadura Tetra",
        "Abertura Fechadura Eletr\u00f4nica",
        "Confec\u00e7\u00e3o de Chave de Carro",
        "Confec\u00e7\u00e3o de Chave de Moto"
      ],
      "default": "Abertura Residencial"
    },
    "status": {
      "type": "string",
      "enum": [
        "searching",
        "ringing",
        "accepted",
        "on_the_way",
        "completed",
        "cancelled"
      ],
      "default": "searching"
    },
    "address": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "urgency": {
      "type": "string",
      "enum": [
        "normal",
        "urgent"
      ],
      "default": "normal"
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "locksmith_id": {
      "type": "string"
    },
    "locksmith_name": {
      "type": "string"
    },
    "locksmith_user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio (User) dono do perfil do chaveiro designado \u2014 usado no RLS para isolar o acesso"
    },
    "ringing_locksmith_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs dos perfis de chaveiro para os quais o chamado est\u00e1 tocando simultaneamente"
    },
    "ringing_locksmith_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs dos usu\u00e1rios (User) dos chaveiros para os quais o chamado est\u00e1 tocando \u2014 usado no RLS"
    },
    "push_notified_locksmith_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Chaveiros que j\u00e1 receberam o push nativo deste chamado (evita alerta repetido)"
    },
    "rejections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "locksmith_id": {
            "type": "string"
          },
          "rering_at": {
            "type": "string",
            "format": "date-time",
            "description": "Momento em que o chamado volta a tocar para este chaveiro"
          }
        }
      },
      "default": [],
      "description": "Recusas por chaveiro \u2014 cada uma com o hor\u00e1rio em que o chamado volta a tocar para ele"
    },
    "rating": {
      "type": "number"
    },
    "review": {
      "type": "string"
    },
    "customer_lat": {
      "type": "number"
    },
    "customer_lng": {
      "type": "number"
    },
    "locksmith_lat": {
      "type": "number"
    },
    "locksmith_lng": {
      "type": "number"
    },
    "key_value": {
      "type": "number",
      "description": "Valor da chave original pesquisado (confec\u00e7\u00e3o de chave de carro)"
    },
    "fipe_value": {
      "type": "number",
      "description": "Valor da Tabela FIPE do ve\u00edculo usado para calcular a m\u00e3o de obra (0,8%)"
    },
    "key_type": {
      "type": "string",
      "description": "Tipo de chave escolhido: simples, canivete, telecomando (carro) ou simples/presenca (moto)"
    },
    "vehicle_info": {
      "type": "string",
      "description": "Resumo do ve\u00edculo/moto informado pelo cliente (marca, modelo, ano)"
    },
    "labor_cost": {
      "type": "number",
      "description": "M\u00e3o de obra fixa (confec\u00e7\u00e3o de chave de carro)"
    },
    "locomotion_cost": {
      "type": "number",
      "description": "Custo de locomo\u00e7\u00e3o (R$ por km \u00d7 dist\u00e2ncia)"
    },
    "distance_km": {
      "type": "number",
      "description": "Dist\u00e2ncia do chaveiro at\u00e9 o cliente em km"
    },
    "extra_cost": {
      "type": "number",
      "default": 0,
      "description": "Custos adicionais informados pelo chaveiro ao aceitar"
    },
    "replaced_parts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Checklist de pe\u00e7as substitu\u00eddas pelo chaveiro durante o atendimento"
    },
    "commission_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid"
      ],
      "default": "pending",
      "description": "Status de compensa\u00e7\u00e3o da comiss\u00e3o de 15% (modo app): pendente ou compensada"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora em que o chaveiro confirmou (aceitou) o servi\u00e7o"
    },
    "cancelled_by": {
      "type": "string",
      "enum": [
        "cliente",
        "chaveiro",
        "sistema"
      ],
      "description": "Quem cancelou a solicita\u00e7\u00e3o \u2014 usado para contar apenas os cancelamentos do cliente no bloqueio autom\u00e1tico"
    },
    "cancellation_fee": {
      "type": "number",
      "default": 0,
      "description": "Taxa de cancelamento cobrada do cliente quando cancela ap\u00f3s 5 min da confirma\u00e7\u00e3o"
    },
    "cancellation_locksmith_amount": {
      "type": "number",
      "default": 0,
      "description": "Parte da taxa de cancelamento destinada ao chaveiro (20% do valor total)"
    },
    "cancellation_app_fee": {
      "type": "number",
      "default": 0,
      "description": "Parte da taxa de cancelamento destinada ao aplicativo (5% do valor total)"
    },
    "cancellation_reason": {
      "type": "string",
      "description": "Motivo do cancelamento (ex.: prazo de chegada expirado)"
    },
    "locksmith_arrived": {
      "type": "boolean",
      "default": false,
      "description": "Chaveiro confirmou que chegou ao local do cliente"
    },
    "client_arrived_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "Cliente confirmou que o chaveiro chegou ao local"
    },
    "start_photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Fotos do in\u00edcio do servi\u00e7o registradas pelo chaveiro ao chegar no local (modo app)"
    },
    "end_photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Fotos do final do servi\u00e7o registradas pelo chaveiro ao concluir o atendimento (modo app)"
    },
    "discount_applied": {
      "type": "boolean",
      "default": false,
      "description": "Indica se o desconto de fidelidade (10%) foi aplicado a este pedido"
    },
    "discount_amount": {
      "type": "number",
      "default": 0,
      "description": "Valor do desconto de fidelidade aplicado ao pedido"
    },
    "payment_id": {
      "type": "string",
      "description": "ID do registro de Payment associado a este pedido"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "credit_card",
        "debit_card",
        "pix",
        "dinheiro"
      ],
      "description": "M\u00e9todo de pagamento selecionado pelo cliente"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "pre_authorized",
        "captured",
        "paid",
        "cancelled",
        "refunded"
      ],
      "default": "pending",
      "description": "Status do pagamento neste pedido"
    },
    "client_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "Cliente confirmou que o chaveiro finalizou o servi\u00e7o"
    },
    "locksmith_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "Chaveiro confirmou a finaliza\u00e7\u00e3o do servi\u00e7o ap\u00f3s solicita\u00e7\u00e3o do cliente"
    },
    "cash_received": {
      "type": "boolean",
      "default": false,
      "description": "Chaveiro confirmou ter recebido o pagamento em dinheiro do cliente"
    },
    "rering_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora em que o chamado recusado deve tocar novamente (legado \u2014 ver rejections)"
    },
    "client_push_sent": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Avisos push j\u00e1 enviados ao cliente (evita repeti\u00e7\u00e3o do mesmo alerta)"
    },
    "urgency_upgrade_status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined"
      ],
      "description": "Status do pedido de mudan\u00e7a para atendimento urgente feito pelo cliente"
    },
    "urgency_upgrade_requested_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do pedido de mudan\u00e7a para urgente \u2014 o chaveiro tem 1 minuto para responder"
    },
    "urgency_upgrade_price": {
      "type": "number",
      "description": "Novo valor do servi\u00e7o caso a mudan\u00e7a para urgente seja aplicada"
    }
  },
  "required": [
    "service_type",
    "address"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.locksmith_user_id": "{{user.id}}"
        },
        {
          "data.ringing_locksmith_user_ids": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.status": "searching"
            },
            {
              "user_condition": {
                "account_type": "chaveiro"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.locksmith_user_id": "{{user.id}}"
        },
        {
          "data.ringing_locksmith_user_ids": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}