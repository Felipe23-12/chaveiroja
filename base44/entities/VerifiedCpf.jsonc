{
  "name": "VerifiedCpf",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "cpf": {
      "type": "string"
    },
    "ownership_verified": {
      "type": "boolean",
      "default": false,
      "description": "Aprova\u00e7\u00e3o manual por administrador ap\u00f3s conferir prova de titularidade. CPF apenas informado ou registros antigos sem aprova\u00e7\u00e3o n\u00e3o liberam privil\u00e9gios."
    },
    "reviewed_by": {
      "type": "string",
      "description": "Administrador que conferiu e aprovou a titularidade."
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_note": {
      "type": "string",
      "maxLength": 1000,
      "description": "Registro da confer\u00eancia manual realizada pelo administrador."
    }
  },
  "required": [
    "user_id",
    "cpf"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}