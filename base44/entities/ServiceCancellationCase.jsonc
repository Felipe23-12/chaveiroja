{
  "name": "ServiceCancellationCase",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "locksmith_id": {
      "type": "string"
    },
    "locksmith_user_id": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "address_incorrect",
        "threat",
        "client_cancelled",
        "service_failed"
      ]
    },
    "report": {
      "type": "string"
    },
    "evidence_photo": {
      "type": "string"
    },
    "evidence_photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 5,
      "default": []
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting_address",
        "waiting_client",
        "threat_suspended",
        "monitoring_service",
        "resolved",
        "cancelled"
      ]
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "client_response": {
      "type": "string",
      "enum": [
        "confirmed",
        "denied",
        "reported"
      ]
    },
    "client_report": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "request_id",
    "client_id",
    "locksmith_id",
    "locksmith_user_id",
    "reason",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "data.locksmith_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}