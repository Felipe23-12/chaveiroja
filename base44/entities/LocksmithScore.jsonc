{
  "name": "LocksmithScore",
  "type": "object",
  "properties": {
    "locksmith_id": {
      "type": "string"
    },
    "locksmith_user_id": {
      "type": "string"
    },
    "score": {
      "type": "number",
      "default": 10
    },
    "accepted_count": {
      "type": "number",
      "default": 0
    },
    "rejected_count": {
      "type": "number",
      "default": 0
    },
    "suspended_until": {
      "type": "string",
      "format": "date-time"
    },
    "abandonment_count": {
      "type": "number",
      "default": 0
    },
    "banned": {
      "type": "boolean",
      "default": false
    },
    "last_heartbeat_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "locksmith_id",
    "locksmith_user_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.locksmith_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}