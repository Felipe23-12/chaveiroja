{
  "name": "ChatReadState",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "locksmith_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "last_read_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "locksmith_id",
    "client_id",
    "last_read_at"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}