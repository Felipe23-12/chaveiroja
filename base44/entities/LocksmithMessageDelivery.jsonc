{
  "name": "LocksmithMessageDelivery",
  "type": "object",
  "properties": {
    "service_request_id": {
      "type": "string"
    },
    "locksmith_id": {
      "type": "string"
    },
    "locksmith_user_id": {
      "type": "string"
    },
    "dedupe_key": {
      "type": "string",
      "description": "Chamado + chaveiro; impede avisos duplicados em reprocessamentos"
    },
    "phone": {
      "type": "string",
      "description": "Telefone do chaveiro em formato E.164"
    },
    "message_text": {
      "type": "string",
      "maxLength": 1600
    },
    "status": {
      "type": "string",
      "enum": [
        "not_configured",
        "no_phone",
        "sending",
        "whatsapp_sent",
        "whatsapp_delivered",
        "sms_sending",
        "sms_sent",
        "sms_delivered",
        "failed"
      ],
      "default": "sending"
    },
    "whatsapp_sid": {
      "type": "string"
    },
    "whatsapp_status": {
      "type": "string"
    },
    "whatsapp_error_code": {
      "type": "string"
    },
    "whatsapp_error_message": {
      "type": "string"
    },
    "sms_sid": {
      "type": "string"
    },
    "sms_status": {
      "type": "string"
    },
    "sms_error_code": {
      "type": "string"
    },
    "sms_error_message": {
      "type": "string"
    },
    "fallback_reason": {
      "type": "string"
    },
    "last_event_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "service_request_id",
    "locksmith_id",
    "dedupe_key",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}