{
  "name": "VehicleKeyCatalog",
  "type": "object",
  "properties": {
    "vehicle_type": {
      "type": "string",
      "enum": [
        "carro",
        "moto"
      ]
    },
    "make": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "year_start": {
      "type": "integer"
    },
    "year_end": {
      "type": "integer"
    },
    "key_style": {
      "type": "string",
      "enum": [
        "lamina_sem_pcf",
        "canivete_sem_pcf",
        "pcf_integrado",
        "presenca",
        "nao_confirmado"
      ],
      "default": "nao_confirmado"
    },
    "factory_alarm_status": {
      "type": "string",
      "enum": [
        "nao_confirmado",
        "original",
        "ausente"
      ],
      "default": "nao_confirmado",
      "description": "Confirma se o ve\u00edculo e intervalo de anos possuem alarme original de f\u00e1brica. Quando ausente, somente chaves paralelas VVDI/KD confirmadas podem ser solicitadas."
    },
    "transponder": {
      "type": "string"
    },
    "transponder_status": {
      "type": "string",
      "enum": [
        "nao_confirmado",
        "presente",
        "ausente"
      ],
      "default": "nao_confirmado",
      "description": "Presen\u00e7a de transponder confirmada para o ve\u00edculo e intervalo de anos. Ausente exibe sem cod; n\u00e3o inferir pela arquitetura sem PCF ou chave simples."
    },
    "programming_machine": {
      "type": "string",
      "description": "Marca e modelo das m\u00e1quinas de codifica\u00e7\u00e3o compat\u00edveis, conferidas para este ve\u00edculo e intervalo de anos. N\u00e3o confundir com os arquivos de gera\u00e7\u00e3o da chave paralela."
    },
    "blade": {
      "type": "string"
    },
    "original_price": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "vvdi_supported": {
      "type": "boolean",
      "default": false
    },
    "vvdi_file": {
      "type": "string"
    },
    "vvdi_price": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "kd_supported": {
      "type": "boolean",
      "default": false
    },
    "kd_file": {
      "type": "string"
    },
    "kd_price": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "km100_supported": {
      "type": "boolean",
      "default": false
    },
    "km100_file": {
      "type": "string"
    },
    "km100_price": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "km100_years": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "default": [],
      "description": "Anos explicitamente confirmados como compat\u00edveis com AUTEL KM100. Vazio indica aplica\u00e7\u00e3o sem ano delimitado na fonte."
    },
    "km100_notes": {
      "type": "string",
      "description": "Aplica\u00e7\u00f5es, procedimentos, chips e ressalvas KM100 descritos pela fonte."
    },
    "km100_source_url": {
      "type": "string",
      "description": "Fonte espec\u00edfica da compatibilidade AUTEL KM100."
    },
    "source_url": {
      "type": "string"
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "active": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "vehicle_type",
    "make",
    "model"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}