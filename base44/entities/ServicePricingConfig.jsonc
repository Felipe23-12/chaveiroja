{
  "name": "ServicePricingConfig",
  "type": "object",
  "properties": {
    "service_type": {
      "type": "string",
      "enum": [
        "Abertura Residencial",
        "Abertura Automotiva",
        "Abertura Fechadura Tetra",
        "Abertura Fechadura Eletr\u00f4nica",
        "Confec\u00e7\u00e3o de Chave de Carro",
        "Confec\u00e7\u00e3o de Chave de Moto",
        "C\u00f3pia de Chave"
      ]
    },
    "values": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "vehicle_fipe_rates": {
      "type": "array",
      "default": [],
      "maxItems": 1000,
      "description": "Percentuais da FIPE por montadora, modelo e ano exatos; substituem apenas o percentual geral da m\u00e3o de obra na confec\u00e7\u00e3o de chave de carro.",
      "items": {
        "type": "object",
        "properties": {
          "make": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "year": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2200
          },
          "percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          }
        },
        "required": [
          "make",
          "model",
          "year",
          "percent"
        ]
      }
    },
    "edited_by": {
      "type": "string"
    }
  },
  "required": [
    "service_type",
    "values"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}