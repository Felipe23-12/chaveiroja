{
  "name": "ServicePricingConfig",
  "type": "object",
  "properties": {
    "service_type": {
      "type": "string",
      "enum": [
        "Abertura Residencial",
        "Abertura Automotiva",
        "Abertura Fechadura Tetra",
        "Abertura Fechadura Eletr\u00f4nica",
        "Confec\u00e7\u00e3o de Chave de Carro",
        "Confec\u00e7\u00e3o de Chave de Moto",
        "C\u00f3pia de Chave"
      ]
    },
    "values": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "vehicle_fipe_rates": {
      "type": "array",
      "default": [],
      "maxItems": 1000,
      "description": "Percentual FIPE e pre\u00e7os manuais das chaves por modelo e faixa de anos.",
      "items": {
        "type": "object",
        "properties": {
          "make": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "year": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2200
          },
          "percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "year_start": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2200
          },
          "year_end": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2200
          },
          "simple_price": {
            "type": "number",
            "minimum": 0,
            "maximum": 20000
          },
          "original_flip_price": {
            "type": "number",
            "minimum": 0,
            "maximum": 20000
          },
          "original_proximity_price": {
            "type": "number",
            "minimum": 0,
            "maximum": 20000
          },
          "simple_price_unavailable": {
            "type": "boolean"
          },
          "original_flip_price_unavailable": {
            "type": "boolean"
          },
          "parallel_flip_price_unavailable": {
            "type": "boolean"
          },
          "original_proximity_price_unavailable": {
            "type": "boolean"
          },
          "parallel_proximity_price_unavailable": {
            "type": "boolean"
          },
          "original_price": {
            "type": "number",
            "minimum": 0,
            "maximum": 20000
          },
          "parallel_simple_price": {
            "type": "number",
            "minimum": 0,
            "maximum": 20000
          },
          "parallel_flip_price": {
            "type": "number",
            "minimum": 0,
            "maximum": 20000
          },
          "parallel_proximity_price": {
            "type": "number",
            "minimum": 0,
            "maximum": 20000
          }
        },
        "required": [
          "make",
          "model",
          "percent"
        ]
      }
    },
    "edited_by": {
      "type": "string"
    }
  },
  "required": [
    "service_type",
    "values"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}