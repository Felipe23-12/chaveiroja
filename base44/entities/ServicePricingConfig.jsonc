{
  "name": "ServicePricingConfig",
  "type": "object",
  "properties": {
    "service_type": {
      "type": "string",
      "enum": [
        "Abertura Residencial",
        "Abertura Automotiva",
        "Abertura Fechadura Tetra",
        "Abertura Fechadura Eletrônica",
        "Confecção de Chave de Carro",
        "Confecção de Chave de Moto",
        "Cópia de Chave"
      ]
    },
    "values": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "vehicle_fipe_rates": {
      "type": "array",
      "default": [],
      "maxItems": 1000,
      "description": "Percentual FIPE e preços manuais das chaves por modelo e faixa de anos.",
      "items": {
        "type": "object",
        "properties": {
          "make": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "year": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2200
          },
          "percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "year_start": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2200
          },
          "year_end": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2200
          },
          "simple_price": {
            "type": "number",
            "minimum": 0,
            "maximum": 20000
          },
          "original_flip_price": {
            "type": "number",
            "minimum": 0,
            "maximum": 20000
          },
          "original_proximity_price": {
            "type": "number",
            "minimum": 0,
            "maximum": 20000
          },
          "simple_price_unavailable": {
            "type": "boolean"
          },
          "original_flip_price_unavailable": {
            "type": "boolean"
          },
          "parallel_flip_price_unavailable": {
            "type": "boolean"
          },
          "original_proximity_price_unavailable": {
            "type": "boolean"
          },
          "parallel_proximity_price_unavailable": {
            "type": "boolean"
          },
          "original_price": {
            "type": "number",
            "minimum": 0,
            "maximum": 20000
          },
          "parallel_simple_price": {
            "type": "number",
            "minimum": 0,
            "maximum": 20000
          },
          "parallel_flip_price": {
            "type": "number",
            "minimum": 0,
            "maximum": 20000
          },
          "parallel_proximity_price": {
            "type": "number",
            "minimum": 0,
            "maximum": 20000
          }
        },
        "required": [
          "make",
          "model",
          "percent"
        ]
      }
    },
    "moto_rules": {
      "type": "array",
      "default": [],
      "maxItems": 1000,
      "description": "Ajuste percentual da faixa de preço da moto por marca, modelo e ano-modelo.",
      "items": {
        "type": "object",
        "properties": {
          "make": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "year_start": {
            "type": "integer"
          },
          "year_end": {
            "type": "integer"
          },
          "percent_adjustment": {
            "type": "number",
            "minimum": -90,
            "maximum": 500
          }
        },
        "required": [
          "make",
          "model",
          "year_start",
          "year_end",
          "percent_adjustment"
        ]
      }
    },
    "edited_by": {
      "type": "string"
    },
    "vehicle_opening_rules": {
      "type": "array",
      "default": [],
      "maxItems": 1000,
      "description": "Preços de abertura e adicional Lishi por montadora, modelo, versão e ano-modelo.",
      "items": {
        "type": "object",
        "properties": {
          "make": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "maxLength": 80
          },
          "year_start": {
            "type": "integer"
          },
          "year_end": {
            "type": "integer"
          },
          "base_price": {
            "type": "number",
            "minimum": 0,
            "maximum": 100000
          },
          "lishi_percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 500
          },
          "simple_unavailable": {
            "type": "boolean"
          },
          "lishi_unavailable": {
            "type": "boolean"
          }
        },
        "required": [
          "make",
          "model",
          "year_start",
          "year_end"
        ]
      }
    },
    "neighborhood_assignments": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Classificação administrativa por código único de bairro, específica deste serviço."
    }
  },
  "required": [
    "service_type",
    "values"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
