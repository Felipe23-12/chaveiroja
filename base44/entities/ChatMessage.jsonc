{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "locksmith_id": {
      "type": "string"
    },
    "locksmith_name": {
      "type": "string"
    },
    "sender_type": {
      "type": "string",
      "enum": [
        "customer",
        "locksmith"
      ],
      "default": "customer"
    },
    "sender_name": {
      "type": "string"
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "locksmith_id",
    "sender_type",
    "message"
  ],
  "rls": {
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}