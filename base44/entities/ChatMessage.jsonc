{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "locksmith_id": {
      "type": "string"
    },
    "locksmith_name": {
      "type": "string"
    },
    "locksmith_user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio (User) dono do perfil do chaveiro \u2014 usado no RLS para o chaveiro ler suas conversas"
    },
    "client_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio (User) cliente nesta conversa \u2014 isola a conversa entre um cliente e o chaveiro"
    },
    "client_name": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "sender_type": {
      "type": "string",
      "enum": [
        "customer",
        "locksmith",
        "system"
      ],
      "default": "customer",
      "description": "Origem da mensagem: customer (cliente), locksmith (chaveiro) ou system (notifica\u00e7\u00e3o autom\u00e1tica do app)"
    },
    "sender_name": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "photo_url": {
      "type": "string",
      "description": "URL da foto enviada pela c\u00e2mera ou galeria no chat"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "locksmith_id",
    "sender_type",
    "message"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "data.locksmith_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}