{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "locksmith_id": {
      "type": "string"
    },
    "locksmith_name": {
      "type": "string"
    },
    "locksmith_user_id": {
      "type": "string",
      "description": "Propriet\u00e1rio do perfil, definido no servidor"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "sender_type": {
      "type": "string",
      "enum": [
        "customer",
        "locksmith",
        "system"
      ],
      "default": "customer"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_user_id": {
      "type": "string",
      "description": "Identidade autenticada definida pelo servidor"
    },
    "review_claimed": {
      "type": "boolean",
      "default": false
    },
    "message": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "locksmith_id",
    "sender_type",
    "message"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "data.locksmith_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}