{
  "name": "LocksmithScoreEvent",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string"
    },
    "locksmith_id": {
      "type": "string"
    },
    "locksmith_user_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "accepted",
        "rejected"
      ]
    },
    "points": {
      "type": "number"
    }
  },
  "required": [
    "request_id",
    "locksmith_id",
    "locksmith_user_id",
    "event_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.locksmith_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}