{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "account_type": {
      "type": "string",
      "description": "Tipo de conta do usu\u00e1rio",
      "enum": [
        "cliente",
        "chaveiro"
      ],
      "default": "cliente"
    },
    "phone": {
      "type": "string",
      "description": "Telefone de contato (usado tamb\u00e9m como login)"
    },
    "cpf": {
      "type": "string",
      "description": "CPF do usu\u00e1rio"
    },
    "username": {
      "type": "string",
      "description": "Nome de usu\u00e1rio escolhido pelo usu\u00e1rio (exibido no app)"
    },
    "avatar_url": {
      "type": "string",
      "description": "Foto de perfil do usu\u00e1rio (c\u00e2mera ou galeria)"
    },
    "terms_accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do \u00faltimo aceite das regras e termos de uso"
    },
    "terms_version": {
      "type": "string",
      "description": "Vers\u00e3o dos termos e regras aceita pelo usu\u00e1rio \u2014 quando os termos mudam, o app exige novo aceite"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}