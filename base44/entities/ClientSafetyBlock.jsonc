{
  "name": "ClientSafetyBlock",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "trigger_request_id": {
      "type": "string"
    },
    "matched_request_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked_until": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "trigger_request_id",
    "blocked_until",
    "reason"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}