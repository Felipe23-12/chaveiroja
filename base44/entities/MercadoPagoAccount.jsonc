{
  "name": "MercadoPagoAccount",
  "type": "object",
  "properties": {
    "locksmith_id": {
      "type": "string"
    },
    "locksmith_user_id": {
      "type": "string"
    },
    "mercado_pago_user_id": {
      "type": "string"
    },
    "access_token": {
      "type": "string"
    },
    "refresh_token": {
      "type": "string"
    },
    "public_key": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "token_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "revoked"
      ],
      "default": "active"
    },
    "connected_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "locksmith_id",
    "locksmith_user_id",
    "mercado_pago_user_id",
    "access_token",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}