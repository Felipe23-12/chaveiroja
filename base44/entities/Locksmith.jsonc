{
  "name": "Locksmith",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "display_name": {
      "type": "string",
      "description": "Nome de exibi\u00e7\u00e3o escolhido pelo chaveiro para o painel (sobrescreve o nome de registro)"
    },
    "specialty": {
      "type": "string",
      "enum": [
        "Residencial",
        "Automotivo",
        "Comercial",
        "Emergencial"
      ],
      "default": "Residencial"
    },
    "specialties": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Residencial",
          "Automotivo",
          "Comercial",
          "Emergencial"
        ]
      },
      "default": [],
      "description": "Especialidades t\u00e9cnicas atendidas pelo chaveiro"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "abertura_residencial",
          "abertura_automotiva",
          "abertura_tetra",
          "abertura_eletronica",
          "confeccao_chave_carro",
          "confeccao_chave_moto"
        ]
      },
      "default": [],
      "description": "Servi\u00e7os espec\u00edficos que o chaveiro atende (IDs do cat\u00e1logo). Vazio = atende todos."
    },
    "service_radius_km": {
      "type": "number",
      "minimum": 1,
      "maximum": 50,
      "default": 15,
      "description": "Raio de atendimento (km) escolhido pelo chaveiro \u2014 limita os chamados que ele recebe"
    },
    "certificates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome do certificado ou curso t\u00e9cnico"
          },
          "issuer": {
            "type": "string",
            "description": "Institui\u00e7\u00e3o emissora"
          },
          "year": {
            "type": "string",
            "description": "Ano de conclus\u00e3o"
          }
        }
      },
      "default": [],
      "description": "Certificados t\u00e9cnicos do chaveiro"
    },
    "rating": {
      "type": "number",
      "default": 5
    },
    "reviews_count": {
      "type": "number",
      "default": 0
    },
    "distance_km": {
      "type": "number",
      "default": 0
    },
    "eta_minutes": {
      "type": "number",
      "default": 0
    },
    "price_per_call": {
      "type": "number",
      "default": 0
    },
    "phone": {
      "type": "string"
    },
    "available": {
      "type": "boolean",
      "default": true
    },
    "avatar_url": {
      "type": "string"
    },
    "vehicle": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "work_mode": {
      "type": "string",
      "enum": [
        "livre",
        "app"
      ],
      "default": "app"
    },
    "custom_price_base": {
      "type": "number",
      "default": 0
    },
    "monthly_fee_paid": {
      "type": "boolean",
      "default": false
    },
    "monthly_fee_due_day": {
      "type": "number",
      "minimum": 1,
      "maximum": 28,
      "default": 1,
      "description": "Dia do m\u00eas escolhido pelo chaveiro (modo livre) para o vencimento da mensalidade"
    },
    "monthly_fee_method": {
      "type": "string",
      "enum": [
        "pix",
        "credit_card",
        "debit_card",
        "boleto"
      ],
      "description": "M\u00e9todo de pagamento da mensalidade (modo livre)"
    },
    "monthly_fee_last_paid": {
      "type": "string",
      "format": "date",
      "description": "Data do \u00faltimo pagamento da mensalidade"
    },
    "receive_app_requests": {
      "type": "boolean",
      "default": true,
      "description": "Se o chaveiro no modo livre aceita receber solicita\u00e7\u00f5es do modo aplicativo"
    },
    "lat": {
      "type": "number",
      "default": -23.55
    },
    "lng": {
      "type": "number",
      "default": -46.63
    },
    "online": {
      "type": "boolean",
      "default": false
    },
    "last_accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do \u00faltimo chamado aceito pelo chaveiro \u2014 base da regra de inatividade de 30 dias"
    },
    "inactive_deactivated": {
      "type": "boolean",
      "default": false,
      "description": "Perfil desativado automaticamente por mais de 30 dias sem aceitar chamados"
    },
    "deactivated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da desativa\u00e7\u00e3o autom\u00e1tica por inatividade"
    },
    "revalidation_documents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Documentos enviados pelo chaveiro na revalida\u00e7\u00e3o do cadastro"
    },
    "revalidated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da \u00faltima revalida\u00e7\u00e3o de documentos conclu\u00edda"
    },
    "wallet_balance": {
      "type": "number",
      "default": 0,
      "description": "Saldo dispon\u00edvel para saque na carteira digital"
    },
    "pending_balance": {
      "type": "number",
      "default": 0,
      "description": "Saldo em processamento (saques solicitados)"
    },
    "pending_cash_commission": {
      "type": "number",
      "default": 0,
      "description": "Comiss\u00e3o acumulada de servi\u00e7os pagos em dinheiro, a ser descontada do pr\u00f3ximo pagamento via app"
    },
    "pix_key_type": {
      "type": "string",
      "enum": [
        "cpf",
        "cnpj",
        "email",
        "phone",
        "random"
      ],
      "description": "Tipo da chave Pix do chaveiro para receber saques"
    },
    "pix_key_value": {
      "type": "string",
      "description": "Chave Pix do chaveiro para receber saques"
    },
    "bank_name": {
      "type": "string",
      "description": "Nome do banco do chaveiro"
    },
    "rejections_today": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de chamados recusados no dia corrente"
    },
    "rejections_date": {
      "type": "string",
      "description": "Data (YYYY-MM-DD) referente \u00e0 contagem de recusas do dia"
    },
    "blocked_until": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora at\u00e9 quando o chaveiro est\u00e1 bloqueado por exceder o limite de recusas di\u00e1rias"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}