{
  "name": "Review",
  "type": "object",
  "properties": {
    "locksmith_id": {
      "type": "string"
    },
    "locksmith_name": {
      "type": "string"
    },
    "client_id": {
      "type": "string",
      "description": "Cliente avaliado pelo chaveiro"
    },
    "customer_name": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "comment": {
      "type": "string",
      "maxLength": 3000
    },
    "service_type": {
      "type": "string"
    },
    "service_request_id": {
      "type": "string",
      "description": "Atendimento conclu\u00eddo que originou a avalia\u00e7\u00e3o"
    },
    "reviewer_id": {
      "type": "string",
      "description": "Usu\u00e1rio autenticado que enviou a avalia\u00e7\u00e3o"
    },
    "review_type": {
      "type": "string",
      "enum": [
        "locksmith",
        "client"
      ],
      "default": "locksmith"
    },
    "work_mode": {
      "type": "string",
      "enum": [
        "livre",
        "app"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "locksmith_id",
    "rating"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.review_type": {
            "$ne": "client"
          }
        },
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "data.reviewer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}