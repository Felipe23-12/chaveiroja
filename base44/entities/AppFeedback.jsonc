{
  "name": "AppFeedback",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "suggestion",
        "experience",
        "bug"
      ]
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3000
    },
    "photo_uris": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 3,
      "default": []
    },
    "reporter_id": {
      "type": "string"
    },
    "reporter_name": {
      "type": "string"
    },
    "reporter_email": {
      "type": "string"
    }
  },
  "required": [
    "category",
    "subject",
    "message",
    "reporter_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}